{
  "manifest_version": 3,
  "name": "鲁班 V2 · P0 运行探针",
  "version": "0.0.1",
  "minimum_chrome_version": "138",
  "description": "仅本地 P0 验证；独立数据库，不读鲁班正式脚本或 Key，无外部模型请求。",
  "permissions": [
    "storage",
    "scripting",
    "userScripts"
  ],
  "optional_host_permissions": [
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "panel.html"
  },
  "options_page": "panel.html"
}
